<style>
:root{--w:#FFFFFF;--ice:#F7F8FA;--g1:#E9EDF2;--g9:#303640;--ink:#15171B;--blue:#8DB8E8;--sage:#A8C3B0;--mut:#6b7380;color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
*,*::before,*::after{box-sizing:inherit}
html{scroll-behavior:smooth;scroll-padding-top:84px;background:var(--ice)}
body{margin:0;background:var(--ice);color:var(--ink);font-family:Inter,system-ui,sans-serif;line-height:1.6;overflow-x:hidden}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);background:rgba(255,255,255,.85);backdrop-filter:blur(14px);z-index:60}
h1,h2,h3,.brand{font-family:Sora,system-ui,sans-serif;margin:0;font-weight:500;letter-spacing:-.02em}
header{position:fixed;top:0;left:0;right:0;z-index:50;display:flex;align-items:center;justify-content:space-between;padding:calc(14px + env(safe-area-inset-top,0px)) 6vw 14px;background:rgba(255,255,255,.72);backdrop-filter:blur(16px);border-bottom:1px solid var(--g1)}
.brand{display:flex;align-items:center;gap:10px;text-decoration:none;color:var(--ink);font-size:1.05rem;letter-spacing:.32em;font-weight:600}
.mark{width:26px;height:26px;transform-style:preserve-3d;animation:turn 12s linear infinite}
@keyframes turn{to{transform:rotateY(360deg)}}
nav{display:flex;gap:34px}
nav a{color:var(--g9);text-decoration:none;font-size:.9rem;position:relative;padding:4px 0}
nav a::after{content:"";position:absolute;left:0;bottom:0;height:1px;width:100%;background:var(--ink);transform:scaleX(0);transform-origin:left;transition:transform .35s}
nav a:hover::after{transform:scaleX(1)}
#burger{display:none;width:44px;height:44px;border:1px solid var(--g1);border-radius:12px;background:var(--w);cursor:pointer;position:relative}
#burger i{position:absolute;left:12px;right:12px;height:1.5px;background:var(--ink);transition:.3s}
#burger i:nth-child(1){top:16px}#burger i:nth-child(2){top:27px}
#burger.open i:nth-child(1){top:21px;transform:rotate(45deg)}#burger.open i:nth-child(2){top:21px;transform:rotate(-45deg)}
section{max-width:1240px;margin:0 auto;padding:110px 6vw}
.hero{min-height:100svh;display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:30px;padding-top:120px;position:relative}
.eyebrow{font-size:.78rem;letter-spacing:.28em;text-transform:uppercase;color:var(--mut);margin-bottom:22px}
.hero h1{font-size:clamp(2.4rem,5.4vw,4.4rem);line-height:1.05;font-weight:300}
.hero h1 b{font-weight:600;background:linear-gradient(90deg,var(--g9),#5d7fa8);-webkit-background-clip:text;background-clip:text;color:transparent}
.hero p{font-size:1.15rem;color:var(--mut);max-width:480px;margin:24px 0 38px}
.rise{opacity:0;animation:rise 1s cubic-bezier(.2,.8,.2,1) forwards;animation-delay:var(--d,0s)}
@keyframes rise{from{opacity:0;transform:translateY(34px)}to{opacity:1;transform:none}}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;padding:15px 30px;border-radius:999px;border:1px solid var(--ink);background:var(--ink);color:var(--w);font:500 .95rem Inter,sans-serif;cursor:pointer;text-decoration:none;position:relative;overflow:hidden;transition:transform .3s,box-shadow .3s,background .3s,color .3s}
.btn::after{content:"";position:absolute;top:0;left:-80%;width:50%;height:100%;background:linear-gradient(100deg,transparent,rgba(255,255,255,.35),transparent);transform:skewX(-20deg);transition:left .7s}
.btn:hover{transform:translateY(-2px);box-shadow:0 14px 30px rgba(21,23,27,.18)}
.btn:hover::after{left:140%}
.btn:active{transform:scale(.96)}
.btn.soft{background:var(--w);color:var(--ink);border-color:var(--g1)}
.stage{position:relative;height:min(68vh,560px)}
#scene{width:100%;height:100%;display:block}
.halo{position:absolute;border-radius:50%;filter:blur(50px);pointer-events:none}
.halo.a{width:260px;height:260px;background:rgba(141,184,232,.35);top:4%;right:4%}
.halo.b{width:220px;height:220px;background:rgba(168,195,176,.4);bottom:6%;left:2%}
.shade{position:absolute;left:25%;right:25%;bottom:3%;height:26px;border-radius:50%;background:radial-gradient(closest-side,rgba(21,23,27,.2),transparent);animation:shade 6s ease-in-out infinite}
@keyframes shade{50%{transform:scale(.8);opacity:.6}}
.head{text-align:center;margin-bottom:46px}
.head h2{font-size:clamp(1.8rem,3.6vw,2.7rem);font-weight:300}
.head p{color:var(--mut);margin:12px auto 0;max-width:520px}
.rv{opacity:0;transform:translateY(40px);transition:opacity .9s,transform .9s cubic-bezier(.2,.8,.2,1);transition-delay:var(--d,0s)}
.rv.show{opacity:1;transform:none}
.search{display:flex;align-items:center;gap:10px;max-width:440px;margin:0 auto 54px;padding:6px 8px 6px 20px;border-radius:999px;background:var(--w);border:1px solid var(--g1);box-shadow:0 8px 30px rgba(48,54,64,.06);transition:box-shadow .3s,border-color .3s}
.search:focus-within{border-color:var(--blue);box-shadow:0 10px 36px rgba(141,184,232,.3)}
.search input{flex:1;border:0;outline:0;background:none;font:400 1rem Inter,sans-serif;color:var(--ink);padding:10px 0;min-width:0}
.search button{border:0;background:var(--g1);color:var(--g9);width:34px;height:34px;border-radius:50%;cursor:pointer;visibility:hidden}
.search.has button{visibility:visible}
.grid{display:grid;grid-template-columns:minmax(0,420px);justify-content:center;gap:36px;perspective:1300px}
.slot{transition:opacity .4s,transform .4s}
.slot.off{display:none}
.card{--rx:0deg;--ry:0deg;--mx:50%;--my:50%;position:relative;background:var(--w);border:1px solid var(--g1);border-radius:26px;padding:16px 16px 28px;transform:rotateX(var(--rx)) rotateY(var(--ry));transform-style:preserve-3d;transition:transform .25s ease-out,box-shadow .4s;box-shadow:0 2px 4px rgba(48,54,64,.04),0 24px 50px -18px rgba(48,54,64,.18)}
.card:hover{box-shadow:0 4px 8px rgba(48,54,64,.05),0 40px 70px -20px rgba(48,54,64,.28)}
.card::after{content:"";position:absolute;inset:0;border-radius:26px;pointer-events:none;background:radial-gradient(300px circle at var(--mx) var(--my),rgba(255,255,255,.7),transparent 55%);opacity:0;transition:opacity .4s}
.card:hover::after{opacity:1}
.art{height:220px;border-radius:18px;overflow:hidden;position:relative;transform:translateZ(30px);box-shadow:0 14px 30px -14px rgba(48,54,64,.3)}
.pic{position:absolute;inset:-6%;animation:drift 11s ease-in-out infinite alternate;animation-delay:var(--f,0s)}
@keyframes drift{from{transform:translate3d(-2%,-1.5%,0) scale(1.02)}to{transform:translate3d(2%,1.5%,0) scale(1.07)}}
.pic svg{width:100%;height:100%;display:block;transition:transform .8s cubic-bezier(.2,.8,.2,1)}
.card:hover .pic svg{transform:scale(1.1)}
.body{padding:24px 12px 0;transform:translateZ(18px)}
.tag{font-size:.72rem;letter-spacing:.2em;text-transform:uppercase;color:var(--mut)}
.card h3{font-size:1.35rem;margin:8px 0 8px}
.card p{color:var(--mut);font-size:.95rem;margin:0 0 22px;min-height:76px}
.row{display:flex;align-items:center;justify-content:space-between;gap:14px}
.price{font:600 1.65rem Sora,sans-serif;letter-spacing:-.02em}
.price small{font:400 .8rem Inter,sans-serif;color:var(--mut);display:block;letter-spacing:0}
.none{text-align:center;color:var(--mut);display:none;padding:30px}
.steps{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:22px}
.step{padding:30px;border-radius:22px;background:rgba(255,255,255,.7);backdrop-filter:blur(14px);border:1px solid var(--g1);box-shadow:0 20px 40px -24px rgba(48,54,64,.2)}
.step b{font:300 2.4rem Sora,sans-serif;color:var(--blue)}
.step h3{font-size:1.05rem;margin:6px 0}
.step p{margin:0;color:var(--mut);font-size:.95rem}
footer{background:var(--ink);color:#c9cdd4;padding:50px 6vw calc(50px + env(safe-area-inset-bottom,0px));text-align:center;font-size:.9rem}
footer .brand{color:var(--w);justify-content:center;margin-bottom:12px}
#modal{position:fixed;inset:0;z-index:100;display:grid;place-items:center;padding:20px;background:rgba(21,23,27,.35);backdrop-filter:blur(10px);opacity:0;visibility:hidden;transition:.4s;perspective:1100px}
#modal.open{opacity:1;visibility:visible}
.panel{position:relative;width:min(440px,100%);max-height:92vh;overflow:auto;background:var(--w);border-radius:26px;padding:34px 30px 30px;box-shadow:0 40px 90px -20px rgba(21,23,27,.4);transform:rotateX(-18deg) translateY(50px) scale(.94);transition:transform .7s cubic-bezier(.2,.9,.2,1)}
#modal.open .panel{transform:none}
.panel h3{font-size:1.3rem}
.panel .pv{display:flex;justify-content:space-between;align-items:baseline;margin:14px 0 22px;padding:16px 18px;background:var(--ice);border-radius:16px;gap:12px}
.panel .pv b{font:600 1.35rem Sora,sans-serif;white-space:nowrap}
.lab{font-size:.75rem;letter-spacing:.18em;text-transform:uppercase;color:var(--mut);margin-bottom:8px}
.pix{display:flex;align-items:center;gap:10px;padding:8px 8px 8px 18px;border:1px solid var(--g1);border-radius:999px;margin-bottom:18px}
.pix code{flex:1;font:500 1.05rem Inter,sans-serif;letter-spacing:.05em}
.pix button{border:0;border-radius:999px;padding:10px 18px;background:var(--blue);color:var(--ink);font:600 .85rem Inter,sans-serif;cursor:pointer;transition:transform .15s,background .3s}
.pix button:active{transform:scale(.92)}
.note{font-size:.85rem;color:var(--mut);background:rgba(168,195,176,.22);border-radius:14px;padding:14px;margin:0 0 20px}
.panel .btn{width:100%}
.x{position:absolute;top:16px;right:16px;width:38px;height:38px;border:0;border-radius:50%;background:var(--g1);cursor:pointer;font-size:1.1rem;color:var(--g9)}
@media(max-width:860px){
 nav{position:fixed;top:0;left:0;right:0;flex-direction:column;align-items:center;gap:22px;padding:calc(96px + env(safe-area-inset-top,0px)) 20px 34px;background:rgba(255,255,255,.97);backdrop-filter:blur(18px);transform:translateY(-110%);transition:transform .5s cubic-bezier(.2,.9,.2,1);z-index:-1;border-bottom:1px solid var(--g1)}
 nav.open{transform:none}
 nav a{font-size:1.1rem}
 #burger{display:block}
 .hero{grid-template-columns:1fr;text-align:center;min-height:auto;padding-top:100px}
 .hero p{margin-inline:auto}
 .stage{height:320px;order:-1}
 section{padding:72px 6vw}
}
@media(prefers-reduced-motion:reduce){
 *,*::before,*::after{animation:none!important;transition-duration:.01ms!important;scroll-behavior:auto!important}
 .rise,.rv{opacity:1;transform:none}
}
</style>
</head>
