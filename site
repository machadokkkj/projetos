 </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
(function(){
"use strict";
var RM=matchMedia("(prefers-reduced-motion: reduce)").matches;
var COARSE=matchMedia("(pointer: coarse)").matches||innerWidth<860;
var $=function(s){return document.querySelector(s)};
var PRICE="R$ 10,99",PIX="43999829224",WA="https://wa.me/5543999829224";

/* Produtos e ilustrações (SVG inline) */
var P=[
 {n:"Marketing Digital (MK)",t:"Estratégia",d:"Estratégias práticas para posicionar sua marca, atrair clientes e vender mais no digital.",
  bg:"#dfe9f6,#F7F8FA",s:'<rect x="60" y="150" width="46" height="70" rx="10" fill="#E9EDF2"/><rect x="128" y="112" width="46" height="108" rx="10" fill="#8DB8E8"/><rect x="196" y="76" width="46" height="144" rx="10" fill="#303640"/><path d="M70 120 130 84 200 52 300 36" stroke="#A8C3B0" stroke-width="6" fill="none" stroke-linecap="round"/><circle cx="300" cy="36" r="10" fill="#A8C3B0"/>'},
 {n:"Tráfego Orgânico",t:"Crescimento",d:"Aprenda a atrair público qualificado de forma consistente, sem depender de anúncios pagos.",
  bg:"#e2eee6,#F7F8FA",s:'<circle cx="200" cy="130" r="92" fill="none" stroke="#E9EDF2" stroke-width="10"/><circle cx="200" cy="130" r="62" fill="none" stroke="#A8C3B0" stroke-width="8" stroke-dasharray="14 12"/><circle cx="200" cy="130" r="30" fill="#303640"/><circle cx="292" cy="130" r="11" fill="#8DB8E8"/><circle cx="130" cy="64" r="9" fill="#8DB8E8"/><circle cx="150" cy="206" r="8" fill="#E9EDF2" stroke="#303640" stroke-width="3"/>'},
 {n:"Xit",t:"Games",d:"Dicas legítimas de configuração e gameplay para jogar melhor, sem hacks ou ferramentas de trapaça.",
  bg:"#e9ecf2,#F7F8FA",s:'<path d="M110 100h180a42 42 0 0 1 42 46l-8 56a22 22 0 0 1-40 8l-14-28H130l-14 28a22 22 0 0 1-40-8l-8-56a42 42 0 0 1 42-46z" fill="#303640"/><path d="M134 128v32M118 144h32" stroke="#E9EDF2" stroke-width="7" stroke-linecap="round"/><circle cx="262" cy="136" r="9" fill="#8DB8E8"/><circle cx="284" cy="156" r="9" fill="#A8C3B0"/>'}
];
function norm(s){return s.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g,"")}
P=P.filter(function(p){return p.n==="Xit"});
var grid=$("#grid");
P.forEach(function(p,i){
 var w=document.createElement("div");
 w.className="slot rv";w.style.setProperty("--d",(i*.12)+"s");
 w.dataset.k=norm(p.n+" "+p.t+" "+p.d);
 w.innerHTML='<article class="card"><div class="art" style="background:linear-gradient(145deg,'+p.bg+')"><div class="pic" style="--f:'+(-i*3)+'s"><svg viewBox="0 0 400 260" preserveAspectRatio="xMidYMid slice" aria-hidden="true">'+p.s+'</svg></div></div><div class="body"><div class="tag">'+p.t+'</div><h3>'+p.n+'</h3><p>'+p.d+'</p><div class="row"><div class="price">'+PRICE+'<small>pagamento único</small></div><button class="btn" data-i="'+i+'">Comprar agora</button></div></div></article>';
 grid.appendChild(w);
});

/* Pesquisa */
var q=$("#q"),sb=$("#sb");
function filter(){
 var v=norm(q.value.trim()),n=0;
 sb.classList.toggle("has",!!v);
 grid.querySelectorAll(".slot").forEach(function(s){var ok=!v||s.dataset.k.indexOf(v)>-1;s.classList.toggle("off",!ok);if(ok)n++});
 $("#none").style.display=n?"none":"block";
}
q.addEventListener("input",filter);
$("#clr").addEventListener("click",function(){q.value="";filter();q.focus()});

/* Tilt 3D */
grid.addEventListener("pointermove",function(e){
 var c=e.target.closest(".card");if(!c)return;
 var r=c.getBoundingClientRect(),x=(e.clientX-r.left)/r.width,y=(e.clientY-r.top)/r.height;
 c.style.setProperty("--mx",x*100+"%");c.style.setProperty("--my",y*100+"%");
 if(COARSE||RM)return;
 c.style.setProperty("--ry",((x-.5)*12)+"deg");c.style.setProperty("--rx",((.5-y)*10)+"deg");
});
grid.addEventListener("pointerleave",function(){grid.querySelectorAll(".card").forEach(function(c){c.style.setProperty("--rx","0deg");c.style.setProperty("--ry","0deg")})},true);

/* Entrada ao rolar */
var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add("show");io.unobserve(e.target)}})},{threshold:.12});
document.querySelectorAll(".rv").forEach(function(el){io.observe(el)});

/* Menu */
var bg=$("#burger"),nav=$("#nav");
function tog(o){bg.classList.toggle("open",o);nav.classList.toggle("open",o);bg.setAttribute("aria-expanded",String(o))}
bg.addEventListener("click",function(){tog(!nav.classList.contains("open"))});
nav.addEventListener("click",function(e){if(e.target.tagName==="A")tog(false)});

/* Modal */
var modal=$("#modal"),last=null;
function openM(i){
 var p=P[i];last=document.activeElement;
 $("#mp").textContent=p.n;$("#mv").textContent=PRICE;
 $("#wa").href=WA+"?text="+encodeURIComponent("Olá! Quero comprar *"+p.n+"* ("+PRICE+"). Segue o comprovante do Pix:");
 $("#copy").textContent="Copiar";
 modal.classList.add("open");modal.setAttribute("aria-hidden","false");$("#close").focus();
}
function closeM(){modal.classList.remove("open");modal.setAttribute("aria-hidden","true");if(last)last.focus()}
grid.addEventListener("click",function(e){var b=e.target.closest("button[data-i]");if(b)openM(+b.dataset.i)});
$("#close").addEventListener("click",closeM);
modal.addEventListener("click",function(e){if(e.target===modal)closeM()});
addEventListener("keydown",function(e){if(e.key==="Escape")closeM()});
$("#copy").addEventListener("click",function(){
 var b=$("#copy");
 function ok(){b.textContent="Copiado ✓"}
 function fb(){var t=document.createElement("textarea");t.value=PIX;document.body.appendChild(t);t.select();try{document.execCommand("copy");ok()}catch(_){b.textContent="Copie a chave"}t.remove()}
 if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(PIX).then(ok,fb)}else fb();
});

/* Parallax */
var mx=0,my=0,tx=0,ty=0,layers=document.querySelectorAll("[data-depth]");
addEventListener("pointermove",function(e){tx=e.clientX/innerWidth*2-1;ty=e.clientY/innerHeight*2-1});

/* Cena 3D */
var draw3=null,vis=true;
(function(){
 var cv=$("#scene");
 if(!window.THREE)return;
 var R;
 try{R=new THREE.WebGLRenderer({canvas:cv,antialias:!COARSE,alpha:true})}catch(_){return}
 R.setPixelRatio(Math.min(devicePixelRatio||1,COARSE?1.5:2));
 var S=new THREE.Scene(),cam=new THREE.PerspectiveCamera(45,1,.1,100);cam.position.z=7.2;
 S.add(new THREE.HemisphereLight(0xffffff,0xb9c8dc,.95));
 var dl=new THREE.DirectionalLight(0xffffff,.9);dl.position.set(3,5,5);S.add(dl);
 var pl=new THREE.PointLight(0x8DB8E8,1.1,20);pl.position.set(-4,-2,4);S.add(pl);
 var g=new THREE.Group();S.add(g);
 var knot=new THREE.Mesh(new THREE.TorusKnotGeometry(1.1,.34,COARSE?120:240,COARSE?18:36),new THREE.MeshStandardMaterial({color:0xf3f5f8,metalness:.3,roughness:.2}));
 g.add(knot);
 var cage=new THREE.Mesh(new THREE.IcosahedronGeometry(2.1,1),new THREE.MeshBasicMaterial({color:0x303640,wireframe:true,transparent:true,opacity:.1}));
 g.add(cage);
 var r1=new THREE.Mesh(new THREE.TorusGeometry(2.55,.018,12,160),new THREE.MeshBasicMaterial({color:0x8DB8E8}));r1.rotation.x=1.2;g.add(r1);
 var r2=new THREE.Mesh(new THREE.TorusGeometry(3,.014,12,160),new THREE.MeshBasicMaterial({color:0xA8C3B0}));r2.rotation.set(.5,.8,0);g.add(r2);
 var orb=new THREE.Mesh(new THREE.SphereGeometry(.16,24,24),new THREE.MeshStandardMaterial({color:0x8DB8E8,roughness:.3}));g.add(orb);
 var orb2=new THREE.Mesh(new THREE.SphereGeometry(.12,24,24),new THREE.MeshStandardMaterial({color:0xA8C3B0,roughness:.3}));g.add(orb2);
 function size(){var w=cv.clientWidth,h=cv.clientHeight;if(!w||!h)return;R.setSize(w,h,false);cam.aspect=w/h;cam.updateProjectionMatrix()}
 size();new ResizeObserver(size).observe(cv);
 new IntersectionObserver(function(e){vis=e[0].isIntersecting}).observe(cv);
 draw3=function(t){
  var s=t/1000;
  if(!RM){
   knot.rotation.x=s*.18;knot.rotation.y=s*.28;cage.rotation.y=-s*.1;cage.rotation.x=s*.06;
   r1.rotation.z=s*.2;r2.rotation.z=-s*.15;
   orb.position.set(Math.cos(s*.7)*2.55,0,Math.sin(s*.7)*2.55);
   orb2.position.set(Math.cos(s*.5+2)*3,Math.sin(s*.5+2)*1.2,Math.sin(s*.5+2)*2);
   g.position.y=Math.sin(s*.9)*.22;
  }
  g.rotation.y+=((mx*.6)-g.rotation.y)*.05;g.rotation.x+=((my*.35)-g.rotation.x)*.05;
  R.render(S,cam);
 };
})();

/* Loop */
var fr=0;
function loop(t){
 mx+=(tx-mx)*.06;my+=(ty-my)*.06;
 if(!RM)layers.forEach(function(el){var d=+el.dataset.depth;el.style.transform="translate3d("+(mx*d)+"px,"+(my*d)+"px,0)"});
 if(draw3&&vis)draw3(t);
 fr++;
 if(!RM||fr<3)requestAnimationFrame(loop);
}
requestAnimationFrame(loop);
})();
</script>
